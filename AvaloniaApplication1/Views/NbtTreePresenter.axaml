<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.Views.NbtTreePresenter"
             xmlns:vm="using:AvaloniaApplication1.ViewModels"
             xmlns:this="using:AvaloniaApplication1.Views"
             xmlns:viewModels="clr-namespace:AvaloniaApplication1.ViewModels"
             x:DataType="viewModels:NbtTreePresenterViewModel">
    <Design.DataContext><vm:NbtTreePresenterViewModel></vm:NbtTreePresenterViewModel>
    </Design.DataContext>
    <StackPanel Orientation="Horizontal">
        <Label Content="{Binding NbtTag.TagType}"></Label>
        <Label Content=" - "></Label>
        <Label Content="{Binding  NbtTag.Name, TargetNullValue=UNNAMED_TAG}"></Label>
        <Label Content=": "></Label>
        <Label Content="{Binding NbtTag.StringValue}"></Label>
    </StackPanel>
</UserControl>
