<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApplication1.Views.Play"
        Margin="12"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:viewModels="clr-namespace:AvaloniaApplication1.ViewModels"
        x:DataType="viewModels:PlayViewModel">
    <Design.DataContext><vm:PlayViewModel></vm:PlayViewModel></Design.DataContext>
    <Grid ColumnDefinitions="2*,6*">
       <Grid >
           <StackPanel Spacing="2">
               <ToggleSwitch OffContent="Offline" OnContent="Online" IsChecked="{Binding IsOnline, Mode=TwoWay}"></ToggleSwitch>
               <ComboBox PlaceholderText="Username" 
                         ItemsSource="{Binding Username.Usernames, Mode=TwoWay}"
                         SelectedIndex="{Binding Username.Index, Mode=TwoWay}"
                         KeyDown="InputElement_OnKeyDown" IsEditable="True"></ComboBox>  
               <Button >Start</Button>
               <Button Click="SelectVersionButtonOnClick">Version Selection</Button>
               <Button Click="VersionSettingsButtonOnClick">Version Settings</Button>
           </StackPanel>
           
       </Grid>
        
       <Grid Grid.Column="1"></Grid>
   </Grid>
   
</UserControl>
